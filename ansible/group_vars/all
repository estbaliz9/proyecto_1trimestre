wordpress_db_name: "wordpress_db"
wordpress_db_user: "wordpress_user"
wordpress_db_password: "wordpress_pass"
wordpress_db_host: "mariadb.example.org"

# Docker - Redes
docker_networks:
  - name: fortune_network
    driver: bridge

# Docker - Contenedores
docker_containers:
  - name: fortune_cookie
    image: simulalex/fortune-cookie-api:1
    state: started
    restart_policy: unless-stopped
    ports:
      - "127.0.0.1:8080:8080"
    networks:
      - name: fortune_network
    labels:
      description: "Fortune Cookie API - Daily wisdom"
